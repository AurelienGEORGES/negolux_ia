# Copier ce fichier en .env et le compléter. Ne jamais versionner le .env.

# --- Serveur HTTP ---------------------------------------------------------
PORT=3000
# 127.0.0.1 en local. 0.0.0.0 pour accepter les connexions d'une autre machine
# ou d'un conteneur (ex : n8n dans Docker).
HOST=127.0.0.1
# Noms d'hôte acceptés dans l'en-tête Host, séparés par des virgules.
# Obligatoire en production derrière un nom de domaine, sinon les requêtes sont rejetées (403).
# ALLOWED_HOSTS=mcp.negolux.fr

# --- Authentification ----------------------------------------------------
# Jeton exigé dans l'en-tête "Authorization: Bearer <jeton>" (32 caractères minimum).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=

# --- Base de données de l'ERP --------------------------------------------
# En production : compte MySQL dédié, limité à SELECT (voir README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=negolux
# true pour chiffrer la connexion (recommandé si la base est distante)
DB_SSL=false
DB_CONNECTION_LIMIT=5

# --- Garde-fous SQL -------------------------------------------------------
# Nombre maximum de lignes renvoyées par requête (au-delà, le résultat est tronqué)
SQL_MAX_ROWS=200
# Durée maximum d'une requête, en millisecondes
SQL_TIMEOUT_MS=15000
