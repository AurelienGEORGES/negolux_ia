{
  "name": "negolux-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Serveur MCP d'accès en lecture seule à la base de données de l'ERP Negolux",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
